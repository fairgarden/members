# Every setting the members service reads.

# Its public URL, before any monolith mount point, which it adds itself.
# Defaults to the Vercel deployment's domain, else localhost:3020.
FG_MEMBERS_URL=https://members.example.com

# The id service it signs in with (its issuer: FG_ID_URL plus any mount
# point, such as /id in a monolith), and the client it is
# enrolled as there (FG_ID_SERVICE_MEMBERS_* on the id service).
FG_MEMBERS_ID_URL=https://id.example.com
FG_MEMBERS_CLIENT_ID=members
FG_MEMBERS_CLIENT_SECRET=the-same-secret-as-FG_ID_SERVICE_MEMBERS_SECRET

# Encrypts the session cookie: a long random value.
FG_MEMBERS_SECRET=

# Any Postgres; DATABASE_URL (set by Neon's Vercel integration) is used when
# this is not. Without either, development runs an embedded database in
# .data/members.
FG_MEMBERS_DATABASE_URL=postgres://user:password@host/db?sslmode=require
# FG_MEMBERS_EMBEDDED_DATABASE_PORT=54320

# Joining and releasing claims follow the organization's policy that this
# deployment was built with (`fg-dist policy use`, in the build), or members'
# built-in rules when there is none. These are shared by every service.
# A policy from elsewhere, as a path or https URL, signed by this key:
# FG_POLICY_BUNDLE=https://policy.example.org/policies.tar.gz
# FG_POLICY_PUBLIC_KEY={"kty":"EC",...}
# Or unsigned, only for trying a policy locally:
# FG_POLICY_ALLOW_UNSIGNED=true
# Or `none`, for the built-in rules whatever the build had:
# FG_POLICY_BUNDLE=none
# Or an OPA server to ask instead:
# FG_POLICY_OPA_URL=http://localhost:8181
# FG_MEMBERS_POLICY_PACKAGE=fairgarden/members
# Every decision is recorded in the database; how long to keep them, and
# whether to write each to standard output as well.
# FG_MEMBERS_POLICY_LOG_RETENTION_DAYS=400
# FG_MEMBERS_POLICY_LOG_STDOUT=true
