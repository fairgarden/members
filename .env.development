# Local development defaults, loaded by `next dev` and the db scripts.
# Override any of them in .env.development.local, which is not committed.

FG_MEMBERS_URL=http://localhost:3020
# The id service (apps/id, on port 3010), and how members is enrolled there:
# these match FG_ID_SERVICE_MEMBERS_* in apps/id/.env.development.
FG_MEMBERS_ID_URL=http://localhost:3010
FG_MEMBERS_CLIENT_ID=members
FG_MEMBERS_CLIENT_SECRET=dev-only-members-secret
# Encrypts the session cookie. Required anywhere but localhost.
FG_MEMBERS_SECRET=dev-only-members-session-secret
